# --- App ---
BMS_APP_NAME=Ticket Watch
BMS_ENVIRONMENT=dev
BMS_HOST=127.0.0.1
BMS_PORT=8765
BMS_TIMEZONE=Asia/Kolkata
BMS_DATABASE_PATH=data/bms_assistant.db
BMS_LOG_LEVEL=INFO

# Polling / reliability
BMS_DEFAULT_CHECK_INTERVAL_SECONDS=5
BMS_MIN_CHECK_INTERVAL_SECONDS=2
BMS_MAX_CONSECUTIVE_ERRORS=5

# --- Telegram (optional) ---
# Create a bot with @BotFather, then send /start to your bot to get your chat id.
# In production, BMS_TELEGRAM_CHAT_ID is required when a bot token is set.
BMS_TELEGRAM_ENABLED=true
# BMS_TELEGRAM_BOT_TOKEN=123456789:replace-me
# BMS_TELEGRAM_CHAT_ID=123456789

# --- Web dashboard auth ---
# Required when BMS_ENVIRONMENT=production. Use at least 12 characters.
# BMS_AUTH_PASSWORD=use-a-long-random-password
# Generate with: openssl rand -hex 32
# BMS_SESSION_SECRET=replace-with-a-random-secret
# Optional bearer token for scripted API calls.
# BMS_API_TOKEN=replace-with-a-random-api-token
# Defaults to true when BMS_ENVIRONMENT=production.
# BMS_SECURE_COOKIES=true
